{
    "name": "ironmcp/core",
    "description": "Hardened, conformant MCP tools that refuse undeclared arguments with a recoverable error and enforce exactly what they advertise.",
    "type": "library",
    "license": "MIT",
    "keywords": ["mcp", "model-context-protocol", "conformance", "hardening", "json-schema", "additionalProperties", "ai-agents", "strict-args", "laravel", "wordpress", "woocommerce"],
    "require": {
        "php": "^8.1",
        "mcp/sdk": "^0.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "IronMcp\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "IronMcp\\Tests\\": "tests/" }
    },
    "config": {
        "allow-plugins": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
